// BAR archiver
// USAGE:
// ./bar -c data/foo.bar data/file1.txt data/file2.txt
// ./bar -e data/foo.bar
// hexdump -C data/foo.bar

pragma unsafe

include "libc/ctypes64"
include "libc/stdio"
include "libc/string"

//  BAR file layout:
//
//  +---------------------------+
//  |       ArchiveHeader       |
//  +===========================+ --.
//  |        FileHeader         |   |
//  +---------------------------+   |
//  |      file name + '\0'     |   |  file #1
//  +---------------------------+   |
//  |                           |   |
//  |        file data          |   |
//  |                           |   |
//  +===========================+ --+
//  |        FileHeader         |   |
//  +---------------------------+   |
//  |      file name + '\0'     |   |  file #2
//  +---------------------------+   |
//  |        file data          |   |
//  +===========================+ --'
//  |            ...            |
//  +---------------------------+

type Version = {major: Nat16, minor: Nat16}

const version: Version = {major = 0, minor = 1}


const maxFileNameLen = 256

type ArchiveHeaderMagic = @branded Word32
const archiveHeaderMagic = ArchiveHeaderMagic 0x12abcdef

type FileHeaderMagic = @branded Word32
const fileHeaderMagic = FileHeaderMagic 0x01234567


type ArchiveHeader = {
	magic: ArchiveHeaderMagic
	version: Version
}

type FileHeader = {
	magic: FileHeaderMagic
	size: Nat64     // file data size in bytes
	nameLen: Nat16  // count without '\0'
}


func main (argc: Int32, argv: *[]*Str8) -> Int32 {
	if argc < 3 {
		showUsage()
		return 1
	}

	if argv[1][0] != "-" {
		printf("error: expected command\n")
		showUsage()
		return 1
	}

	let arname: *Str8 = argv[2]
	let cmd: Char8 = argv[1][1]
	let files = &argv[3:]

	//printf("cmd = %c\n", cmd)
	//printf("arname = '%s'\n", arname)

	if cmd == 'e' {
		cmdExtract(arname)
	} else if cmd == 'c' {
		cmdCreate(arname, files)
	} else if cmd == 'a' {
		cmdAppend(arname, files)
	} else if cmd == 'd' {
		cmdDelete(arname, files)
	} else {
		printf("error: unsupported key -%c\n", cmd)
		showUsage()
		return 1
	}

	return 0
}


func cmdCreate (name: *Str8, files: *[]*Str8) -> Unit {
	printf("cmdCreate():\n")

	let afp = fopen(name, "wb")
	if afp == nil {
		printf("error: cannot create file '%s'", name)
		return
	}

	var ah: ArchiveHeader = {
		magic = archiveHeaderMagic
		version = version
	}

	if fwrite(&ah, sizeof(ArchiveHeader), 1, afp) == 0 {
		// error
	}

	fclose(afp)

	cmdAppend(name, files)
}


func cmdAppend (name: *Str8, files: *[]*Str8) -> Unit {
	printf("cmdAppend():\n")

	// "ab" is write-only, so the header can't be read back; use "r+b"
	let afp = fopen(name, "r+b")
	if afp == nil {
		printf("error: cannot open file '%s'\n", name)
		return
	}

	var ah = readArchiveHeader(afp)
	if not checkArchiveHeader(&ah) {
		printf("error: file '%s' isnt a bar archive\n", name)
		fclose(afp)
		return
	}

	// switching from reading to writing requires a seek
	fseek(afp, 0, seekEnd)

	var i: Int32 = 0
	while files[i] != nil {
		append(afp, files[i])
		++i
	}

	fclose(afp)
}


func append (afp: *File, filename: *Str8) -> Unit {
	printf("append('%s')\n", filename)

	let fp = fopen(filename, "rb")
	if fp == nil {
		printf("error: cannot open file '%s'", filename)
		return
	}

	let nameLen = strlen(filename)

	if nameLen > maxFileNameLen {
		// error: too long file name for BAR file
	}

	var fh = FileHeader {
		magic=fileHeaderMagic
		size = getFileSize(fp)
		nameLen = unsafe(Nat16 nameLen)
	}

	//printFileHeader(&fh)
	writeFileHeader(afp, &fh)

	// write filename + '\0' before file data
	if fwrite(filename, nameLen, 1, afp) == 0 {
		// error: cannot write filename into archive file
	}
	var zeroChar: Char8 = '\0'
	if fwrite(&zeroChar, sizeof(zeroChar), 1, afp) == 0 {
		// error: cannot write filename into archive file
	}

	var b: Byte
	while true {
		if fread(&b, sizeof(Byte), 1, fp) == 0 {
			break
		}

		if fwrite(&b, sizeof(Byte), 1, afp) == 0 {
			break
		}
	}

	fclose(fp)
}


func cmdDelete (name: *Str8, files: *[]*Str8) -> Unit {
	printf("cmdDelete():\n")
	var i: Int32 = 0
	while true {
		let srcname = files[i]
		if srcname == nil {
			return
		}
		printf("+ file: %s\n", files[i])
		++i
	}
}


func cmdExtract (name: *Str8) -> Unit {
	printf("cmdExtract('%s')\n", name)
	let afp = fopen(name, "rb")
	if afp == nil {
		printf("error: cannot open file '%s'", name)
		return
	}

	var ah = readArchiveHeader(afp)
	if not checkArchiveHeader(&ah) {
		printf("error: file '%s' isnt a bar archive", name)
		fclose(afp)
		return
	}

	while true {
		// 1. Получаем файловый заголовок
		var fh: FileHeader
		if fread(&fh, sizeof(FileHeader), 1, afp) == 0 {
			// end of archive file
			printf("<reached end of archive file>\n")
			break
		}

		//printFileHeader(&fh)
		if not checkFileHeader(&fh) {
			// error: invalid file header
		}

		// 2. Затем вытаскиваем имя файла
		var filenamebuf: [2+maxFileNameLen+1]Char8 = "./"
		readFileName(afp, &filenamebuf[2:], maxFileNameLen)

		printf("EXTRACT: '%s' (%lluB) >\n", &filenamebuf, fh.size)

		// 3. Теперь создаем файл и пишем в него данные из архива
		let fp = fopen(&filenamebuf, "wb")
		if fp == nil {
			printf("error: cannot create file '%s'", filenamebuf)
			return
		}

		var b: Byte
		var i: Nat64
		while i < fh.size {
			if fread(&b, sizeof(Byte), 1, afp) == 0 {
				break
			}

			if fwrite(&b, sizeof(Byte), 1, fp) == 0 {
				break
			}

			++i
		}

		fclose(fp)
	}

	fclose(afp)
	return
}


func readFileName (afp: *File, fnamebuf: *[]Char8, limit: Nat32) -> Unit {
	var c: Char8
	var i: Nat32
	while true {
		if fread(&c, sizeof(Byte), 1, afp) == 0 {
			// error: cannot read filename character
			break
		}
		if i == limit {
			if c != '\0' {
				// error: filename is too long
			}
			break
		}
		fnamebuf[i] = c
		if c == '\0' {
			break
		}
		++i
	}
	fnamebuf[i] = '\0'
}


func getFileSize (fp: *File) -> Nat64 {
	fseek(fp, 0, seekEnd)
	let size = ftell(fp)
	fseek(fp, 0, seekSet)
	return unsafe(Nat64 size)
}


func writeFileHeader (afp: *File, fh: *FileHeader) -> Unit {
	printf("writeFileHeader()\n")
	if fwrite(fh, sizeof(FileHeader), 1, afp) == 0 {
		//
	}
}


func readArchiveHeader (afp: *File) -> ArchiveHeader {
	var ah: ArchiveHeader
	if fread(&ah, sizeof(ArchiveHeader), 1, afp) == 0 {
		// error cannot read archive header
	}
	return ah
}


func checkVersion (v: Version) -> Bool {
	if v.major < version.major {
		return true
	} else if v.major == version.major {
		return v.minor <= version.minor
	}
	return false
}


func checkArchiveHeader (ah: *ArchiveHeader) -> Bool {
	return ah.magic == archiveHeaderMagic and checkVersion(ah.version)
}


func checkFileHeader (fh: *FileHeader) -> Bool {
	if fh.magic != fileHeaderMagic {
		return false
	}

	if fh.nameLen == 0 or fh.nameLen > maxFileNameLen {
		return false
	}

	return true
}


@unused
func printArchiveHeader (ah: *ArchiveHeader) -> Unit {
	printf("ArchiveHeader {\n")
	printf("    magic = 0x%08x\n", ah.magic)
	printf("    version = %u.%u\n", ah.version.major, ah.version.minor)
	printf("}\n")
}


@unused
func printFileHeader (fh: *FileHeader) -> Unit {
	printf("FileHeader {\n")
	printf("    magic = 0x%08x\n", fh.magic)
	printf("    nameLen = %u\n", Nat32 fh.nameLen)
	printf("    size = %llu\n", fh.size)
	printf("}\n")
}


func showUsage () -> Unit {
	printf("usage: bar -<cmd> archive_name.bar [files...]\n")
	printf("  -c  create archive from files\n")
	printf("  -a  append files to archive\n")
	printf("  -e  extract all files from archive\n")
	printf("  -d  delete files from archive\n")
}

