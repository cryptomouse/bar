// BAR archiver
// USAGE:
// ./bar -c data/foo.bar data/file1.txt data/file2.txt
// ./bar -e data/foo.bar
// hexdump -C data/foo.bar

pragma unsafe

include "libc/ctypes64"
include "libc/stdio"

import "bar"


func main (argc: Int32, argv: *[]*Str8) -> Int32 {
	if argc < 3 {
		showUsage()
		return 1
	}

	if argv[1][0] != "-" {
		printf("error: expected command\n")
		showUsage()
		return 1
	}

	let arname: *Str8 = argv[2]
	let cmd: Char8 = argv[1][1]
	let files = &argv[3:]

	//printf("cmd = %c\n", cmd)
	//printf("arname = '%s'\n", arname)

	if cmd == 'e' {
		bar.cmdExtract(arname, files)
	} else if cmd == 'c' {
		bar.cmdCreate(arname, files)
	} else if cmd == 'a' {
		bar.cmdAppend(arname, files)
	} else if cmd == 'd' {
		bar.cmdDelete(arname, files)
	} else if cmd == 'l' {
		bar.cmdList(arname)
	} else {
		printf("error: unsupported key -%c\n", cmd)
		showUsage()
		return 1
	}

	return 0
}


func showUsage () -> Unit {
	printf("BAR archiver v%d.%d\n", bar.version.major, bar.version.minor)
	printf("usage: bar -<cmd> archive_name.bar [files...]\n")
	printf("  -c  create archive from files\n")
	printf("  -a  append files to archive\n")
	printf("  -e  extract all files from archive\n")
	printf("  -l  show all files in archive\n")
	printf("  -d  delete files from archive\n")
}

