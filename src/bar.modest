
pragma unsafe

include "libc/ctypes64"
include "libc/stdio"
include "libc/string"

//  BAR file layout:
//
//  +---------------------------+
//  |       ArchiveHeader       |
//  +===========================+ --.
//  |        SectionHeader      |   |
//  +---------------------------+   |
//  |      file name + '\0'     |   |  file #1
//  +---------------------------+   |
//  |                           |   |
//  |        file data          |   |
//  |                           |   |
//  +===========================+ --+
//  |        SectionHeader      |   |
//  +---------------------------+   |
//  |      file name + '\0'     |   |  file #2
//  +---------------------------+   |
//  |        file data          |   |
//  +===========================+ --'
//  |            ...            |
//  +---------------------------+

public type Version = @public {major: Nat16, minor: Nat16}
public type VersionRange = @public {begin: Version, end: Version}

public const version: Version = {major = 0, minor = 1}

public const supportedVersionRange: VersionRange = {
    begin = {major = 0, minor = 0}
    end = {major = 0, minor = 1}
}


const maxFileNameLen = 256
const maxChunkSize = 4096


type ArchiveHeaderMagic = @branded Word32
const archiveHeaderMagic = ArchiveHeaderMagic 0x12abcdef

type ArchiveHeader = {
	magic: ArchiveHeaderMagic
	version: Version
}


type SectionHeaderMagic = @branded Word32
const sectionHeaderMagic = SectionHeaderMagic 0x01234567

type SectionType = @branded Nat32
const sectionTypeFile = SectionType 0


type SectionHeader = {
	magic: SectionHeaderMagic
	type: SectionType
	size: Nat64	 // file data size in bytes
	nameLen: Nat16  // filename characters count (without '\0')
}


public func cmdCreate (name: *Str8, files: *[]*Str8) -> Unit {
	printf("cmdCreate():\n")

	let afp = fopen(name, "wb")
	if afp == nil {
		printf("error: cannot create file '%s'", name)
		return
	}

	var ah: ArchiveHeader = {
		magic = archiveHeaderMagic
		version = version
	}

	if fwrite(&ah, sizeof(ArchiveHeader), 1, afp) == 0 {
		// error
	}

	fclose(afp)

	cmdAppend(name, files)
}


public func cmdAppend (name: *Str8, files: *[]*Str8) -> Unit {
	printf("cmdAppend():\n")

	let ax = openArchive(name, "r+b")
	if ax.afp == nil {
		return
	}

	// switching from reading to writing requires a seek
	fseek(ax.afp, 0, seekEnd)

	var i: Int32 = 0
	while files[i] != nil {
		append(ax.afp, files[i])
		++i
	}

	fclose(ax.afp)
}


func append (afp: *File, filename: *Str8) -> Unit {
	printf("append('%s')\n", filename)

	let fp = fopen(filename, "rb")
	if fp == nil {
		printf("error: cannot open file '%s'", filename)
		return
	}

	let nameLen = strlen(filename)

	if nameLen > maxFileNameLen {
		// error: too long file name for BAR file
	}

	let fileSize = getFileSize(fp)
	var sh = SectionHeader {
		magic = sectionHeaderMagic
		type = sectionTypeFile
		size = fileSize
		nameLen = unsafe(Nat16 nameLen)
	}

	//printSectionHeader(&sh)
	writeSectionHeader(afp, &sh)

	// write filename + '\0' before file data
	if fwrite(filename, nameLen, 1, afp) == 0 {
		// error: cannot write filename into archive file
	}
	var zeroChar: Char8 = '\0'
	if fwrite(&zeroChar, sizeof(zeroChar), 1, afp) == 0 {
		// error: cannot write filename into archive file
	}

	pump(fp, afp, fileSize)
	fclose(fp)
}


public func cmdDelete (name: *Str8, files: *[]*Str8) -> Unit {
	printf("cmdDelete():\n")
	var i: Int32 = 0
	while true {
		let srcname = files[i]
		if srcname == nil {
			return
		}
		printf("+ file: %s\n", files[i])
		++i
	}
}


public func cmdExtract (name: *Str8, onlyfiles: *[]*Str8) -> Unit {
	printf("cmdExtract('%s')\n", name)

	let ax = openArchive(name, "rb")
	if ax.afp == nil {
		return
	}

	while true {
		// 1. Получаем файловый заголовок
		var sh: SectionHeader
		if fread(&sh, sizeof(SectionHeader), 1, ax.afp) == 0 {
			// end of archive file
			printf("<reached end of archive file>\n")
			break
		}

		//printSectionHeader(&sh)
		if not checkSectionHeader(&sh) {
			// error: invalid file header
		}

		// 2. Затем вытаскиваем имя файла
		var filenamebuf: [2+maxFileNameLen+1]Char8 = "./"
		readFileName(ax.afp, &filenamebuf[2:], maxFileNameLen)

		printf("SEE %s\n", &filenamebuf)

		if not isFileToExtract(&filenamebuf[2:], onlyfiles) {
			// перемотка на след файл
			fseek(ax.afp, LongInt sh.size, seekCur)
			again
		}

		printf("EXTRACT: '%s' (%lluB) >\n", &filenamebuf, sh.size)

		// 3. Теперь создаем файл и пишем в него данные из архива
		let fp = fopen(&filenamebuf, "wb")
		if fp == nil {
			printf("error: cannot create file '%s'", filenamebuf)
			return
		}

		pump(ax.afp, fp, sh.size)
		fclose(fp)

	}

	fclose(ax.afp)
	return
}


func getFileInfo (afp: *File) -> {} {

}


public func cmdList (name: *Str8) -> Unit {
	printf("cmdList('%s')\n", name)

	let ax = openArchive(name, "rb")
	if ax.afp == nil {
		return
	}

	printf("#\tSIZE\tFILE\n")

	var i: Nat32
	while true {
		// 1. Получаем файловый заголовок
		var sh: SectionHeader
		if fread(&sh, sizeof(SectionHeader), 1, ax.afp) == 0 {
			// end of archive file
			printf("<reached end of archive file>\n")
			break
		}

		//printSectionHeader(&sh)
		if not checkSectionHeader(&sh) {
			// error: invalid file header
		}

		// 2. Затем вытаскиваем имя файла
		var filenamebuf: [2+maxFileNameLen+1]Char8 = "./"
		readFileName(ax.afp, &filenamebuf[2:], maxFileNameLen)

		printf("%u\t%lluB\t%s\n", i, sh.size, &filenamebuf)

		// мотаем вперед
		fseek(ax.afp, LongInt sh.size, seekCur)

		++i
	}

	fclose(ax.afp)
}


// if onlyfiles == nil or filename in onlyfiles
func isFileToExtract (filename: *Str8, onlyfiles: *[]*Str8) -> Bool {
	if onlyfiles[0] == nil {
		// There is no specified files, extract all
		return true
	}

	var i: Nat32 = 0
	while true {
		if onlyfiles[i] == nil {
			return false
		}
		if strcmp(filename, onlyfiles[i]) == 0 {
			return true
		}
		++i
	}

	return false
}


func pump (fsrc: *File, fdst: *File, len: Nat64) -> Unit {
	var buf: [maxChunkSize]Byte
	var rest = len
	while rest > 0 {
		var chunkSize = rest
		if rest > maxChunkSize {
			chunkSize = maxChunkSize
		}

		if fread(&buf, sizeof(Byte), chunkSize, fsrc) == 0 {
			break
		}

		if fwrite(&buf, sizeof(Byte), chunkSize, fdst) == 0 {
			break
		}

		rest = rest - chunkSize
	}
}


func readFileName (afp: *File, fnamebuf: *[]Char8, limit: Nat32) -> Unit {
	var c: Char8
	var i: Nat32
	while true {
		if fread(&c, sizeof(Byte), 1, afp) == 0 {
			// error: cannot read filename character
			break
		}
		if i == limit {
			if c != '\0' {
				// error: filename is too long
			}
			break
		}
		fnamebuf[i] = c
		if c == '\0' {
			break
		}
		++i
	}
	fnamebuf[i] = '\0'
}


func getFileSize (fp: *File) -> Nat64 {
	fseek(fp, 0, seekEnd)
	let size = ftell(fp)
	fseek(fp, 0, seekSet)
	return unsafe(Nat64 size)
}


func openArchive (filename: *Str8, mode: *Str8) -> {afp: *File, ah: ArchiveHeader} {
	let afp = fopen(filename, mode)
	if afp == nil {
		printf("error: cannot open archive file '%s'\n", filename)
		return {afp=afp, ah={}}
	}

	var ah = readArchiveHeader(afp)
	if not checkArchiveHeader(&ah) {
		printf("error: file '%s' isnt a bar archive\n", filename)
		fclose(afp)
		return {afp=nil, ah=ah}
	}

	return {afp=afp, ah=ah}
}


func writeSectionHeader (afp: *File, sh: *SectionHeader) -> Unit {
	printf("writeSectionHeader()\n")
	if fwrite(sh, sizeof(SectionHeader), 1, afp) == 0 {
		//
	}
}


func readArchiveHeader (afp: *File) -> ArchiveHeader {
	var ah: ArchiveHeader
	if fread(&ah, sizeof(ArchiveHeader), 1, afp) == 0 {
		// error cannot read archive header
	}
	return ah
}


func checkArchiveHeader (ah: *ArchiveHeader) -> Bool {
	return ah.magic == archiveHeaderMagic and
        isVersionInRange(ah.version, supportedVersionRange)
}


func checkSectionHeader (sh: *SectionHeader) -> Bool {
	if sh.magic != sectionHeaderMagic {
		return false
	}

	if sh.nameLen == 0 or sh.nameLen > maxFileNameLen {
		return false
	}

	return true
}


@unused
func printArchiveHeader (ah: *ArchiveHeader) -> Unit {
	printf("ArchiveHeader {\n")
	printf("    magic = 0x%08x\n", ah.magic)
	printf("    version = %u.%u\n", ah.version.major, ah.version.minor)
	printf("}\n")
}


@unused
func printSectionHeader (sh: *SectionHeader) -> Unit {
	printf("SectionHeader {\n")
	printf("   magic = 0x%08x\n", sh.magic)
	printf("   nameLen = %u\n", Nat32 sh.nameLen)
	printf("   size = %llu\n", sh.size)
	printf("}\n")
}



func isVersionInRange (v: Version, range: VersionRange) -> Bool  {
	return versionIsGreaterOrEqual(v, range.begin) and
		versionIsLessOrEqual(v, range.end)
}


func versionIsLessOrEqual (v: Version, w: Version) -> Bool {
	if v.major < w.major {
		return true
	} else if v.major == w.major {
		return v.minor <= w.minor
	}
	return false
}


func versionIsGreaterOrEqual (v: Version, w: Version) -> Bool {
	if v.major > w.major {
		return true
	} else if v.major == w.major {
		return v.minor >= w.minor
	}
	return false
}

